{
  "compilerOptions": {
    "target": "ES2020",
  "module": "NodeNext",
  "moduleResolution": "NodeNext",
  "resolveJsonModule": true,
  "allowSyntheticDefaultImports": true,
  "outDir": "../dist",
  "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "server.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "client"]
}
